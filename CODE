import java.util.*;

class InvalidAgeException extends Exception {
    public InvalidAgeException(String message) {
        super(message);
    }
}

abstract class Person {
    protected int id;
    protected String name;

    Person(int id, String name) {
        this.id = id;
        this.name = name;
    }

    abstract void display();

    public int getId() {
        return id;
    }
}

class Patient extends Person {

    private int age;
    private String disease;

    Patient(int id, String name, int age, String disease) {
        super(id, name);
        this.age = age;
        this.disease = disease;
    }

    public String getDisease() {
        return disease;
    }

    @Override
    void display() {
        System.out.println("--------------------------------");
        System.out.println("Patient ID : " + id);
        System.out.println("Name       : " + name);
        System.out.println("Age        : " + age);
        System.out.println("Disease    : " + disease);
    }
}

class Doctor extends Person {

    private String specialization;
    private int experience;
    private double fee;

    Doctor(int id,
           String name,
           String specialization,
           int experience,
           double fee) {

        super(id, name);
        this.specialization = specialization;
        this.experience = experience;
        this.fee = fee;
    }

    public double getFee() {
        return fee;
    }

    public int getExperience() {
        return experience;
    }

    @Override
    void display() {
        System.out.println("--------------------------------");
        System.out.println("Doctor ID      : " + id);
        System.out.println("Name           : " + name);
        System.out.println("Specialization : " + specialization);
        System.out.println("Experience     : " + experience);
        System.out.println("Consult Fee    : ₹" + fee);
    }
}

public class HospitalManagementSystem {

    static Scanner sc = new Scanner(System.in);

    static ArrayList<Patient> patients = new ArrayList<>();
    static ArrayList<Doctor> doctors = new ArrayList<>();

    // Recursive Search
    static Patient searchPatient(int index, int id) {

        if (index == patients.size())
            return null;

        if (patients.get(index).getId() == id)
            return patients.get(index);

        return searchPatient(index + 1, id);
    }

    static void addPatient() {

        try {

            System.out.print("Patient ID : ");
            int id = sc.nextInt();
            sc.nextLine();

            System.out.print("Name : ");
            String name = sc.nextLine();

            System.out.print("Age : ");
            int age = sc.nextInt();
            sc.nextLine();

            if (age <= 0)
                throw new InvalidAgeException(
                        "Age must be greater than 0");

            System.out.print("Disease : ");
            String disease = sc.nextLine();

            patients.add(
                    new Patient(id, name, age, disease));

            System.out.println("Patient Added Successfully!");

        } catch (InvalidAgeException e) {

            System.out.println(e.getMessage());

        } catch (Exception e) {

            System.out.println("Invalid Input!");
            sc.nextLine();
        }
    }

    static void addDoctor() {

        try {

            System.out.print("Doctor ID : ");
            int id = sc.nextInt();
            sc.nextLine();

            System.out.print("Name : ");
            String name = sc.nextLine();

            System.out.print("Specialization : ");
            String spec = sc.nextLine();

            System.out.print("Experience : ");
            int exp = sc.nextInt();

            System.out.print("Consultation Fee : ");
            double fee = sc.nextDouble();

            doctors.add(
                    new Doctor(id, name, spec, exp, fee));

            System.out.println("Doctor Added Successfully!");

        } catch (Exception e) {

            System.out.println("Invalid Input!");
            sc.nextLine();
        }
    }

    static void displayPatients() {

        if (patients.isEmpty()) {
            System.out.println("No Patients Found!");
            return;
        }

        for (Patient p : patients)
            p.display();
    }

    static void displayDoctors() {

        if (doctors.isEmpty()) {
            System.out.println("No Doctors Found!");
            return;
        }

        for (Doctor d : doctors)
            d.display();
    }

    static void searchPatientMenu() {

        System.out.print("Enter Patient ID : ");
        int id = sc.nextInt();

        Patient p = searchPatient(0, id);

        if (p == null)
            System.out.println("Patient Not Found!");
        else
            p.display();
    }

    static void generateBill() {

        if (doctors.isEmpty()) {
            System.out.println("No Doctor Available!");
            return;
        }

        System.out.print("Patient ID : ");
        int pid = sc.nextInt();

        Patient p = searchPatient(0, pid);

        if (p == null) {
            System.out.println("Patient Not Found!");
            return;
        }

        System.out.print("Doctor ID : ");
        int did = sc.nextInt();

        Doctor doctor = null;

        for (Doctor d : doctors) {
            if (d.getId() == did) {
                doctor = d;
                break;
            }
        }

        if (doctor == null) {
            System.out.println("Doctor Not Found!");
            return;
        }

        System.out.print("Medicine Charges : ");
        double medicine = sc.nextDouble();

        System.out.print("Room Charges : ");
        double room = sc.nextDouble();

        double total =
                doctor.getFee() + medicine + room;

        System.out.println("\n===== BILL =====");
        System.out.println("Consultation : ₹" +
                doctor.getFee());
        System.out.println("Medicine     : ₹" +
                medicine);
        System.out.println("Room Charges : ₹" +
                room);
        System.out.println("--------------------");
        System.out.println("Total Bill   : ₹" +
                total);
    }

    static void sortDoctors() {

        Collections.sort(
                doctors,
                (d1, d2) ->
                        d2.getExperience()
                                - d1.getExperience());

        System.out.println(
                "Doctors Sorted By Experience!");
    }

    static void reports() {

        System.out.println("\n===== REPORT =====");

        System.out.println(
                "Total Patients : "
                        + patients.size());

        System.out.println(
                "Total Doctors  : "
                        + doctors.size());

        int fever = 0;

        for (Patient p : patients) {
            if (p.getDisease()
                    .equalsIgnoreCase("fever"))
                fever++;
        }

        System.out.println(
                "Patients With Fever : "
                        + fever);
    }

    public static void main(String[] args) {

        int choice;

        do {

            System.out.println(
                    "\n========== HOSPITAL MANAGEMENT ==========");

            System.out.println("1. Add Patient");
            System.out.println("2. Add Doctor");
            System.out.println("3. Display Patients");
            System.out.println("4. Display Doctors");
            System.out.println("5. Search Patient");
            System.out.println("6. Generate Bill");
            System.out.println("7. Sort Doctors");
            System.out.println("8. Reports");
            System.out.println("9. Exit");

            System.out.print("Enter Choice : ");

            choice = sc.nextInt();

            switch (choice) {

                case 1:
                    addPatient();
                    break;

                case 2:
                    addDoctor();
                    break;

                case 3:
                    displayPatients();
                    break;

                case 4:
                    displayDoctors();
                    break;

                case 5:
                    searchPatientMenu();
                    break;

                case 6:
                    generateBill();
                    break;

                case 7:
                    sortDoctors();
                    break;

                case 8:
                    reports();
                    break;

                case 9:
                    System.out.println(
                            "Thank You!");
                    break;

                default:
                    System.out.println(
                            "Invalid Choice!");
            }

        } while (choice != 9);
    }
}
